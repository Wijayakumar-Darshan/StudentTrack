// schema.prisma
// Full Prisma schema for the Student Performance System

// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  passwordHash  String   @map("password_hash")
  fullName      String?  @map("full_name")
  role          String
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Stream {
  id       Int       @id @default(autoincrement())
  name     String    @unique

  subjects Subject[]
  careers  Career[]
  students Student[]

  @@map("streams")
}

model Subject {
  id        Int            @id @default(autoincrement())
  name      String
  streamId  Int            @map("stream_id")

  stream    Stream         @relation(fields: [streamId], references: [id])
  marks     Mark[]
  cutoffs   CareerCutoff[]

  @@unique([name, streamId])
  @@map("subjects")
}

model Career {
  id        Int            @id @default(autoincrement())
  name      String
  streamId  Int            @map("stream_id")

  stream    Stream         @relation(fields: [streamId], references: [id])
  cutoffs   CareerCutoff[]
  students  Student[]

  @@unique([name, streamId])
  @@map("careers")
}

model CareerCutoff {
  id        Int     @id @default(autoincrement())
  careerId  Int     @map("career_id")
  subjectId Int     @map("subject_id")
  minMarks  Float   @map("min_marks")

  career    Career  @relation(fields: [careerId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@unique([careerId, subjectId])
  @@map("career_cutoffs")
}

model Student {
  regNo        String   @id @map("reg_no")
  name         String
  grade        Int      @default(10)
  classSection String   @default("A") @map("class_section")
  streamId     Int?     @map("stream_id")
  careerId     Int?     @map("career_id")

  stream       Stream?  @relation(fields: [streamId], references: [id])
  career       Career?  @relation(fields: [careerId], references: [id])
  marks        Mark[]

  @@map("students")
}

model Mark {
  id        Int     @id @default(autoincrement())
  regNo     String  @map("reg_no")
  subjectId Int     @map("subject_id")
  term      Int     // 1, 2, or 3
  year      Int
  grade     Int     @default(10)
  marks     Float

  student   Student @relation(fields: [regNo], references: [regNo])
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@unique([regNo, subjectId, term, year])
  @@map("marks")
}